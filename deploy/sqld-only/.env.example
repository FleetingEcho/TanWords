# Copy to .env and keep it private (chmod 600 .env).
# Public IP address or DNS hostname of the server running this stack.
TANWORDS_PUBLIC_HOST=replace-with-server-ip-or-hostname

# Auth secret this sqld instance's clients need. This one must stay LOCAL —
# it's never uploaded, only its derived public key is. deploy.sh generates it
# automatically if missing; sign-token.mjs turns it into a bearer token.
# Rotating this value and redeploying invalidates every token signed under
# the old one. Independent of the main app deployment's TANWORDS_SQLD_AUTH_KEY
# if you also run that — each sqld instance has its own.
TANWORDS_SQLD_AUTH_KEY=replace-with-output-of-openssl-rand-hex-32
