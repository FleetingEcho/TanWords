# Let's Encrypt requires its short-lived (six-day) ACME profile for public
# IP-address certificates. Caddy renews these certificates automatically.
{
	default_sni {$TANWORDS_PUBLIC_HOST}
}

{$TANWORDS_PUBLIC_HOST}:8443 {
	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}

	# sqld pools/reuses backend connections poorly across an idle gap on its
	# own side; Caddy reusing a pooled connection sqld has since closed shows
	# up as a bare 502 "broken pipe" with nothing logged on sqld's side at
	# all. Disabling keepalive trades a little latency for a fresh connection
	# per request, which sidesteps the mismatch entirely.
	reverse_proxy sqld:8080 {
		transport http {
			keepalive off
		}
	}
}
