# Copy to .env and keep it private (chmod 600 .env).
# Public IP address or DNS hostname used by Caddy, deployment, and verification.
TANWORDS_PUBLIC_HOST=replace-with-server-ip-or-hostname

# Generate each value independently; never reuse the invite key as the admin key.
TANWORDS_MASTER_KEY=replace-with-output-of-openssl-rand-hex-32
TANWORDS_INVITE_KEY=replace-with-output-of-openssl-rand-hex-16
TANWORDS_ADMIN_KEY=replace-with-output-of-openssl-rand-hex-16

# Auth secret for the sqld service, which exposes a database directly over
# libsql (Settings > Cloud tab in the desktop app), independent of any
# TanWords account. Unlike the keys above, this one must stay LOCAL — it's
# never uploaded, only its derived public key is. deploy-server.sh generates
# it automatically if missing; deploy/sqld/sign-token.mjs turns it into a
# bearer token. Rotating this value and redeploying invalidates every token
# signed under the old one.
TANWORDS_SQLD_AUTH_KEY=replace-with-output-of-openssl-rand-hex-32
