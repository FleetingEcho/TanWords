# syntax=docker/dockerfile:1.7

# The renderer must exist before Cargo compiles rust-embed into the server.
FROM oven/bun:1 AS frontend
WORKDIR /src/app
# Dependency installation is keyed only by the manifests. Previously `COPY
# app/` came first, so changing any TS/TSX file invalidated this layer and made
# every build reinstall the full frontend dependency tree.
COPY app/package.json app/bun.lock ./
RUN --mount=type=cache,id=tanwords-bun-cache,target=/root/.bun/install/cache \
    bun install --frozen-lockfile
COPY app/ ./
RUN bun run build

FROM rust:bookworm AS backend
# -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false: the
# podman VM clock can lag behind real time after the macOS host sleeps, which
# makes apt reject Release files as "not valid yet" and fail the build.
RUN apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update \
    && apt-get install -y --no-install-recommends \
       build-essential clang cmake pkg-config libssl-dev libdbus-1-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY app/core/ app/core/
COPY web/server/ web/server/
COPY --from=frontend /src/app/out/renderer/ app/out/renderer/
WORKDIR /src/web/server
# Source changes still rerun Cargo, but registry downloads and compiled
# dependencies survive that invalidation in Podman/Docker BuildKit caches. Copy
# the finished binary outside the target cache so it becomes part of the stage.
RUN --mount=type=cache,id=tanwords-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=tanwords-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=tanwords-web-target,target=/src/web/server/target \
    cargo build --release --locked \
    && cp target/release/tanwords-web-server /tmp/tanwords-web-server

FROM debian:bookworm-slim AS runtime
RUN apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update \
    && apt-get install -y --no-install-recommends ca-certificates curl libssl3 libstdc++6 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 tanwords \
    && useradd --system --uid 10001 --gid tanwords --home-dir /nonexistent --shell /usr/sbin/nologin tanwords \
    && install -d -o tanwords -g tanwords -m 0700 /data

COPY --from=backend /tmp/tanwords-web-server /usr/local/bin/tanwords-web-server

ENV TANWORDS_HOST=0.0.0.0 \
    TANWORDS_PORT=8740 \
    TANWORDS_DATA_DIR=/data \
    TANWORDS_TRUST_PROXY=1

USER tanwords
EXPOSE 8740
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl --fail --silent --show-error http://127.0.0.1:8740/ >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/tanwords-web-server"]
