{
  "name": "tanwords",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "homepage": "https://github.com/FleetingEcho/TanWords",
  "scripts": {
    "dev": "bun run core:build:dev && electron-vite dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "bun run typecheck && electron-vite build",
    "core:build": "cd core && cargo build --release",
    "core:build:dev": "cd core && cargo build",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "bun run core:build && bun run build && electron-builder",
    "package:linux": "bun run package -- --linux",
    "package:mac": "bun run package -- --mac",
    "package:win": "bun run package -- --win"
  },
  "dependencies": {
    "@blocknote/code-block": "^0.51.4",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.24.0",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "electron-updater": "^6.6.2"
  },
  "main": "out/main/index.js"
}
