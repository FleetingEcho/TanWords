{
  "name": "tanwords",
  "private": true,
  "version": "1.18.4",
  "desktopName": "tanwords",
  "type": "module",
  "homepage": "https://github.com/FleetingEcho/TanWords",
  "scripts": {
    "dev": "bun run core:build:dev && vite",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:web:front": "TANWORDS_WEB_DEV=1 vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "bun run typecheck && vite build",
    "core:build": "cd core && cargo build --release",
    "core:build:dev": "cd core && cargo build",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "bun run core:build && bun run build && electron-builder",
    "package:linux": "bun run package -- --linux",
    "package:mac": "bun run package -- --mac && bash scripts/verify-release-data.sh",
    "package:win": "bun run package -- --win"
  },
  "overrides": {
    "@tiptap/core": "3.29.2",
    "@tiptap/pm": "3.29.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shikijs/core": "^4",
    "@shikijs/engine-javascript": "^4",
    "@shikijs/langs-precompiled": "^4",
    "@shikijs/themes": "^4",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-drag-handle-react": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-unique-id": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@tiptap/suggestion": "3.29.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^1.28.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "prosemirror-highlight": "^0.15",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.6.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "main": "out/main/index.js"
}
