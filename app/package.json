{
  "name": "tanwords",
  "private": true,
  "version": "2.6.0",
  "desktopName": "tanwords",
  "type": "module",
  "homepage": "https://github.com/FleetingEcho/TanWords",
  "scripts": {
    "dev": "bun run core:build:dev && vite",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:web:front": "TANWORDS_WEB_DEV=1 vite",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "bun run typecheck && vite build",
    "core:build": "cd core && cargo build --release",
    "core:build:dev": "cd core && cargo build",
    "test": "vitest",
    "test:run": "vitest run",
    "package": "bun run core:build && bun run build && electron-builder",
    "package:linux": "bun run package -- --linux",
    "package:mac": "bun run package -- --mac && bash scripts/verify-release-data.sh",
    "package:win": "bun run package -- --win"
  },
  "overrides": {
    "@tiptap/core": "3.32.1",
    "@tiptap/pm": "3.32.1",
    "@tiptap/extension-collaboration": "3.32.1",
    "@tiptap/extension-node-range": "3.32.1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
