diff --git a/node_modules/@xterm/addon-image/lib/addon-image-hidpi.mjs b/lib/addon-image-hidpi.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..4373b23b613823c4414c04f342d3e7813bc56da3
--- /dev/null
+++ b/lib/addon-image-hidpi.mjs
@@ -0,0 +1,43 @@
+import { ImageAddon as BaseImageAddon } from './addon-image.mjs';
+
+function syncCanvasResolution(renderer) {
+  const canvas = renderer?.canvas;
+  if (!canvas) return;
+
+  const cssWidth = renderer.dimensions?.css.canvas.width || 0;
+  const cssHeight = renderer.dimensions?.css.canvas.height || 0;
+  const backingWidth = renderer.dimensions?.device.canvas.width || 0;
+  const backingHeight = renderer.dimensions?.device.canvas.height || 0;
+  canvas.style.width = `${cssWidth}px`;
+  canvas.style.height = `${cssHeight}px`;
+  if (canvas.width !== backingWidth || canvas.height !== backingHeight) {
+    canvas.width = backingWidth;
+    canvas.height = backingHeight;
+  }
+  renderer._ctx?.setTransform(
+    cssWidth > 0 ? canvas.width / cssWidth : 1,
+    0,
+    0,
+    cssHeight > 0 ? canvas.height / cssHeight : 1,
+    0,
+    0,
+  );
+}
+
+/** Keep the upstream parser/storage intact while making its image canvas use a
+ * HiDPI backing store. Protocol geometry and draw calls remain in CSS pixels. */
+export class ImageAddon extends BaseImageAddon {
+  activate(terminal) {
+    super.activate(terminal);
+    const renderer = this._renderer;
+    if (!renderer) return;
+
+    const insertLayerToDom = renderer.insertLayerToDom.bind(renderer);
+    renderer.insertLayerToDom = () => {
+      insertLayerToDom();
+      syncCanvasResolution(renderer);
+    };
+    renderer.rescaleCanvas = () => syncCanvasResolution(renderer);
+    syncCanvasResolution(renderer);
+  }
+}
