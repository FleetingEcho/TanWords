{
  "name": "tanwords-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://github.com/FleetingEcho/TanWords",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd ../server && cargo run",
    "start": "cd ../server && cargo run --release",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "bun run typecheck && vite build",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
