# TanWords web build.
#
# Two things have to happen in order, and the order is the only subtle part:
# the renderer is compiled *into* the server binary (rust-embed), so the
# frontend must be built before cargo runs. `make build` does both.
#
#   make            what the targets are
#   make dev        dev loop, HMR frontend + cargo-run backend
#   make build      frontend, then the single release binary
#   make keys       generate server/.env with fresh secrets (once, per host)
#   make run        run the release binary using server/.env
#   make test       every test in the repo
#   make check      typecheck + clippy + cargo-audit
#
# Requires: bun, cargo. `make doctor` says which are missing.

SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c

ROOT     := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
APP      := $(ROOT)/app
SERVER   := $(ROOT)/web/server
RENDERER := $(APP)/out/renderer
BINARY   := $(SERVER)/target/release/tanwords-web-server
ENV_FILE := $(SERVER)/.env

# Loaded by every recipe that needs secrets. `set -a` exports what it sources
# so the child process inherits it; sourcing rather than `include` because a
# value containing `#` or spaces is a legal secret but not legal Makefile.
LOAD_ENV := set -a; . "$(ENV_FILE)"; set +a

.DEFAULT_GOAL := help
.PHONY: help doctor dev build frontend server keys run test check clean clean-dev print-env

help: ## Show this list
	@echo "TanWords web — build and run"
	@echo
	@grep -hE '^[a-z-]+:.*?## ' $(MAKEFILE_LIST) \
	  | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[1m%-12s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo "First time on a new host:  make keys && make build && make run"

doctor: ## Check that the toolchain is present
	@missing=0; \
	for tool in bun cargo; do \
	  if command -v $$tool >/dev/null 2>&1; then \
	    printf "  \033[32m✓\033[0m %-6s %s\n" "$$tool" "$$(command -v $$tool)"; \
	  else \
	    printf "  \033[31m✗\033[0m %-6s not found\n" "$$tool"; missing=1; \
	  fi; \
	done; \
	if [ -f "$(ENV_FILE)" ]; then \
	  printf "  \033[32m✓\033[0m %-6s %s\n" ".env" "$(ENV_FILE)"; \
	else \
	  printf "  \033[33m!\033[0m %-6s missing — run: make keys\n" ".env"; \
	fi; \
	exit $$missing

# ── build ────────────────────────────────────────────────────────────────

frontend: ## Build the renderer only (app/out/renderer)
	@echo "==> frontend"
	cd "$(APP)" && bun install --frozen-lockfile && bun run build

server: ## Build the server only (assumes the renderer is current)
	@echo "==> server (embeds $(RENDERER))"
	@test -d "$(RENDERER)" || { \
	  echo "error: $(RENDERER) does not exist. Run 'make frontend' first."; exit 1; }
	cd "$(SERVER)" && cargo build --release
	@echo
	@echo "  binary: $(BINARY)"
	@du -h "$(BINARY)" | cut -f1 | sed 's/^/  size:   /'

build: frontend server ## Build everything into one deployable binary

# ── run ──────────────────────────────────────────────────────────────────

keys: ## Generate server/.env with fresh secrets (refuses to overwrite)
	@if [ -f "$(ENV_FILE)" ]; then \
	  echo "error: $(ENV_FILE) already exists."; \
	  echo "       Delete it deliberately if you mean to rotate the keys —"; \
	  echo "       losing TANWORDS_MASTER_KEY orphans every stored Turso token"; \
	  echo "       and AI provider key."; \
	  exit 1; \
	fi
	@umask 077 && { \
	  echo "# Generated by 'make keys'. Secrets — never commit this file."; \
	  echo "#"; \
	  echo "# MASTER_KEY seals stored Turso tokens and AI provider keys at rest."; \
	  echo "# Back it up. Losing it means every user re-enters those credentials."; \
	  echo "TANWORDS_MASTER_KEY=$$(openssl rand -hex 32)"; \
	  echo; \
	  echo "# Hand this one to people you invite. It only permits registration."; \
	  echo "TANWORDS_INVITE_KEY=$$(openssl rand -hex 16)"; \
	  echo; \
	  echo "# Keep this one to yourself. It can set any account's password from"; \
	  echo "# the email address alone, so it must never equal the invite key."; \
	  echo "TANWORDS_ADMIN_KEY=$$(openssl rand -hex 16)"; \
	  echo; \
	  echo "# 127.0.0.1 keeps the port unreachable except through your reverse"; \
	  echo "# proxy, which is the precondition TANWORDS_TRUST_PROXY relies on."; \
	  echo "TANWORDS_HOST=127.0.0.1"; \
	  echo "TANWORDS_PORT=8740"; \
	  echo; \
	  echo "# Where users.db and users/<id>/ live. Back this up."; \
	  echo "TANWORDS_DATA_DIR=$$HOME/.tanwords-web"; \
	  echo; \
	  echo "# Set to 1 ONLY when nothing but your reverse proxy can reach the"; \
	  echo "# port. Off behind a proxy: every user shares one rate-limit bucket,"; \
	  echo "# so ten failed logins from anyone lock out everyone. On while the"; \
	  echo "# port is directly reachable: any caller forges X-Forwarded-For and"; \
	  echo "# skips the limiter entirely."; \
	  echo "TANWORDS_TRUST_PROXY=0"; \
	} > "$(ENV_FILE)"
	@chmod 600 "$(ENV_FILE)"
	@echo "wrote $(ENV_FILE) (mode 600)"
	@echo
	@echo "  invite key (share):  $$(grep '^TANWORDS_INVITE_KEY=' "$(ENV_FILE)" | cut -d= -f2)"
	@echo "  admin key  (keep):   $$(grep '^TANWORDS_ADMIN_KEY=' "$(ENV_FILE)" | cut -d= -f2)"
	@echo
	@echo "Back up TANWORDS_MASTER_KEY somewhere other than this machine."

run: ## Run the release binary using server/.env
	@test -f "$(ENV_FILE)" || { echo "error: no $(ENV_FILE). Run: make keys"; exit 1; }
	@test -x "$(BINARY)"   || { echo "error: no binary. Run: make build"; exit 1; }
	@$(LOAD_ENV); \
	if [ -n "$${TANWORDS_ADMIN_KEY:-}" ] && [ "$${TANWORDS_ADMIN_KEY:-}" = "$${TANWORDS_INVITE_KEY:-}" ]; then \
	  echo "error: TANWORDS_ADMIN_KEY equals TANWORDS_INVITE_KEY."; \
	  echo "       The invite key is in the hands of everyone you invited, and"; \
	  echo "       the admin key resets any account's password by email alone."; \
	  echo "       Identical, every invited user can take over every account."; \
	  exit 1; \
	fi; \
	exec "$(BINARY)"

print-env: ## Show the effective config, secrets masked
	@test -f "$(ENV_FILE)" || { echo "no $(ENV_FILE)"; exit 1; }
	@$(LOAD_ENV); \
	mask() { if [ -z "$$1" ]; then echo "(unset)"; else echo "$${1:0:4}…$${1: -2} ($${#1} chars)"; fi; }; \
	echo "  TANWORDS_MASTER_KEY   $$(mask "$${TANWORDS_MASTER_KEY:-}")"; \
	echo "  TANWORDS_INVITE_KEY   $$(mask "$${TANWORDS_INVITE_KEY:-}")"; \
	echo "  TANWORDS_ADMIN_KEY    $$(mask "$${TANWORDS_ADMIN_KEY:-}")"; \
	echo "  TANWORDS_HOST         $${TANWORDS_HOST:-127.0.0.1}"; \
	echo "  TANWORDS_PORT         $${TANWORDS_PORT:-8740}"; \
	echo "  TANWORDS_DATA_DIR     $${TANWORDS_DATA_DIR:-(platform default)}"; \
	echo "  TANWORDS_TRUST_PROXY  $${TANWORDS_TRUST_PROXY:-0}"

dev: ## Dev loop: HMR frontend on :5420, cargo-run backend on :8740
	cd "$(APP)" && bun run dev:web

# ── verify ───────────────────────────────────────────────────────────────

test: ## Run frontend, server and core tests
	@echo "==> frontend"
	cd "$(APP)" && bunx vitest run
	@echo "==> web server"
	cd "$(SERVER)" && cargo test
	@echo "==> core (web feature — the build the server actually links)"
	cd "$(APP)/core" && cargo test --lib --no-default-features --features web

check: ## Typecheck, lint and audit
	@echo "==> typecheck"
	cd "$(APP)" && bun run typecheck
	@echo "==> clippy"
	cd "$(SERVER)" && cargo clippy --release -- -D warnings
	@echo "==> cargo audit"
	@if command -v cargo-audit >/dev/null 2>&1; then \
	  cd "$(SERVER)" && cargo audit; \
	else \
	  echo "  cargo-audit not installed — skipping. Install: cargo install cargo-audit"; \
	fi

# ── clean ────────────────────────────────────────────────────────────────

clean: ## Remove build output (keeps .env and user data)
	rm -rf "$(APP)/out" "$(SERVER)/target"

clean-dev: ## Remove the dev server's scratch data (.dev-data, .dev-secrets)
	rm -rf "$(SERVER)/.dev-data" "$(SERVER)/.dev-secrets"
